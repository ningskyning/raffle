<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ning.infrastructure.persistent.dao.IStrategyAwardDao">

    <resultMap id="dataMap" type="com.ning.infrastructure.persistent.po.StrategyAwardPO">
        <id column="id" property="id"/>
        <result column="award_id" property="awardId"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="award_subtitle" property="awardSubtitle"/>
        <result column="award_title" property="awardTitle"/>
        <result column="award_rate" property="rate"/>
        <result column="award_rule" property="ruleModel"/>
        <result column="award_total_amount" property="awardTotalAmount"/>
        <result column="award_surplus_amount" property="awardSurplusAmount"/>
        <result column="sort" property="sort"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryStrategyAwardList" resultMap="dataMap">
        select strategy_id
        from strategy_award
                 limit 10
    </select>


</mapper>
